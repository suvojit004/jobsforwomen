# =============================================================================
# JobsForWomen frontend -- environment template
#
# Copy to .env and adjust:   cp .env.example .env
# Full reference: docs/04_ENVIRONMENT_VARIABLES.md
# =============================================================================

# Absolute URL of the backend API.
#
# IMPORTANT: Vite inlines import.meta.env.* into the bundle at BUILD time, so
# this is not read at runtime. Changing it requires a rebuild -- setting it as
# a runtime environment variable on a container or host has no effect.
# When building the Docker image, pass it as a build argument instead:
#   docker build --build-arg VITE_API_URL=https://api.example.com .
VITE_API_URL="http://localhost:5000"
