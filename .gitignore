# Node modules
node_modules/

# Environment variables
.env
.env.*
# ...but DO track the templates -- they contain placeholders only, and the
# README/installation guide instruct contributors to copy them.
!.env.example

# Build output
dist/
build/

# Coverage
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Prisma generated files (optional)
prisma/generated/

# Cache
.cache/

# Private keys / certificates -- never commit these
*.pem

# One-off deliverables (docker deploy guide zip/pdf) -- not source, not
# meant to be versioned; the files themselves stay on disk for the person
# who asked for them, they just don't need git history.
deploy-kit-handoff/
