datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  PendingVerification
  PendingApproval
  Active
  Rejected
  Suspended
  Blocked
}

enum CompanyStatus {
  draft
  submitted
  pending
  pending_verification
  under_review
  approved
  rejected
  info_requested
  // Distinct from `rejected`/`info_requested` -- those are verification-
  // workflow outcomes for a company that never got approved. `suspended` is
  // a moderation action against a company that WAS approved and operating,
  // same conflation of verification-workflow + moderation status that
  // UserStatus already has (PendingVerification/Rejected alongside
  // Active/Suspended/Blocked). Unsuspending always restores `approved`
  // rather than tracking whatever the prior sub-state was -- see
  // AdminService.suspendCompany/unsuspendCompany.
  suspended
}

// Per-perk approval workflow (Parts 6/7 of the recruiter-onboarding spec).
// Deliberately independent from CompanyStatus -- a company's registration
// approval and its individual perk claims (Menstrual Leave Champion, Flexible
// Hours, etc.) must never be conflated (see CompanyPerkRequest below).
enum PerkStatus {
  pending
  approved
  rejected
  info_requested
}

enum JobStatus {
  draft
  pending_approval
  approved
  paused
  closed
  archived
  flagged
}

enum JobVisibility {
  visible
  hidden
}

enum WorkMode {
  Remote
  Hybrid
  On_site
}

enum ApplicationStatus {
  Applied
  Reviewed
  Shortlisted
  InterviewScheduled
  OfferReleased
  Rejected
  Hired
  // Candidate-initiated withdrawal -- previously withdrawing an application
  // just set it to Rejected, which is misleading (the recruiter never
  // rejected them, they withdrew of their own accord) and made it impossible
  // to tell the two apart anywhere in the UI.
  Withdrawn
}

// "Report Platform Issue" ticket lifecycle. Deliberately just three states --
// this is a small internal helpdesk queue, not a full ITSM workflow (no
// Reopened/Escalated/Pending-on-Customer states requested).
enum TicketStatus {
  Open
  InProgress
  Resolved
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String? // Nullable for OAuth-only users
  status           UserStatus @default(PendingVerification)
  // twoFactorEnabled existed for a long time as a stub -- nothing ever read
  // or wrote it, so the "Force Two-Factor (2FA)" control on Administrative
  // Settings was honestly disabled. Now real: twoFactorSecret holds the
  // AES-256-GCM-encrypted TOTP secret (see shared/utils/twoFactor.ts), null
  // until enrollment completes; twoFactorEnabled flips to true only once
  // enrollment is confirmed with a valid code (AuthService.
  // confirmTwoFactorEnrollment).
  twoFactorEnabled Boolean    @default(false)
  twoFactorSecret  String?
  // Durable admin-tier account lockout, set by AuthService.login() once
  // Redis-tracked failed attempts (see shared/utils/loginSecurity.ts) cross
  // ADMIN_LOGIN_LOCKOUT_THRESHOLD within the sliding window. Null/past =
  // not locked. This is the real thing behind the "Admin sessions are
  // tracked by IP audit registries. Suspicious access patterns trigger
  // instant lockouts" claim on Administrative Settings, which previously
  // had nothing admin-specific backing it at all -- just the generic,
  // IP-keyed authRateLimiter every auth endpoint gets.
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  preferences      Json? // Appearance, privacy, email notification settings

  // Relations
  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
  adminProfile     AdminProfile?
  roles            UserRole[]
  refreshTokens    RefreshToken[]
  sessions         Session[]
  chats            ConversationParticipant[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  verifications    CompanyVerificationHistory[]
  featureFlags     FeatureFlag[]
  oauthAccounts    OAuthAccount[]
  jobReports       JobReport[]
  updatedSecurityPolicies SecurityPolicy[]
  updatedPlatformSettings PlatformSettings[]

  // Invitations
  createdInvitations Invitation[] @relation("Inviter")

  // Support tickets (Report Platform Issue -- Candidate/Recruiter/Admin-tier
  // submitters, Support Executive assignees)
  submittedTickets SupportTicket[]        @relation("TicketSubmitter")
  assignedTickets  SupportTicket[]        @relation("TicketAssignee")
  ticketComments   SupportTicketComment[] @relation("TicketCommentAuthor")
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // e.g. "google"
  providerUserId String // ID from the OAuth provider
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
}

model EmailVerification {
  id         String    @id @default(uuid())
  email      String    @unique
  token      String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
}

model PasswordReset {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Invitation {
  id          String    @id @default(uuid())
  email       String    @unique
  token       String    @unique
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id])
  invitedById String
  invitedBy   User      @relation("Inviter", fields: [invitedById], references: [id])
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // Candidate, Recruiter, Admin, Moderator, Super Admin, Support Executive
  permissions RolePermission[]
  users       UserRole[]
  invitations Invitation[]
}

model Permission {
  id    String           @id @default(uuid())
  name  String           @unique // manage:job, moderate:job, manage:users etc
  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model CandidateProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  title              String?
  bio                String?
  phone              String?
  location           String?
  totalExperience    String?
  careerBreak        Json?
  preferredLocations String[]
  availability       String?
  avatarUrl          String?
  avatarPublicId     String?
  resumeUrl          String?
  resumePublicId     String?
  resumeMetadata     Json? // File type, size details from Cloudinary
  languages          String[]
  noticePeriod       String?
  expectedSalary     String?

  experience  Json[] // Array of JobHistory DTOs
  education   Json[] // Array of AcademicDegree DTOs
  socialLinks Json[] // Array of Link DTOs

  // Relations
  skills       CandidateSkill[]
  applications Application[]
  savedJobs    SavedJob[]
}

model RecruiterProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  fullName  String
  phone     String?
  verified  Boolean @default(false)
  jobs      Job[]
}

model AdminProfile {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
}

model Industry {
  id        String    @id @default(uuid())
  name      String    @unique
  companies Company[]
}

model Department {
  id   String @id @default(uuid())
  name String @unique
  jobs Job[]
}

model Company {
  id                    String        @id @default(uuid())
  name                  String        @unique
  description           String?
  website               String
  location              String
  status                CompanyStatus @default(pending)
  feedback              String?
  // "Registration Date" for the admin Company Registration Requests table
  // (Part 2 of the recruiter-onboarding spec). Nullable-safe default so
  // existing rows backfill to the migration's apply time rather than null.
  createdAt             DateTime      @default(now())

  // Secure, single-use, expiring resubmission token (Part 3). Generated by
  // admin.service.ts's verifyCompany() when status is set to info_requested;
  // consumed (set back to null) the moment the recruiter successfully
  // resubmits via the public /company-verification/:token flow.
  verificationToken            String?   @unique
  verificationTokenExpiresAt   DateTime?
  // The recruiter's reply/comment left on the secure resubmission page, and
  // when that resubmission happened -- surfaced to admins on CompanyDetails
  // so they immediately see what changed without digging through audit logs.
  recruiterResubmissionComment String?
  resubmittedAt                DateTime?
  logoUrl               String?
  logoPublicId          String?
  logoMetadata          Json?
  verificationDocuments Json? // Array of docs: { url, publicId, size, mimetype, category }

  // Part 5: expanded Company Profile -- office photo gallery and workplace
  // policy statements shown to candidates browsing this company's listings.
  // galleryImages: appended-only Json array of
  // { url, publicId, size, mimetype, caption, uploadedAt }, same versioned/
  // never-overwritten shape as verificationDocuments/perk documents (Part 13).
  // policies: Json array of { title, description } -- deliberately a free-form
  // list rather than a fixed enum of named policy fields, consistent with how
  // CompanyPerkRequest.perkName is a free string ("extensible, not an enum,
  // per spec's any future certifications") -- recruiters can add whichever
  // named policies are relevant to them (POSH/maternity/equal pay/etc).
  galleryImages         Json?
  policies              Json?

  industryId            String
  industry              Industry      @relation(fields: [industryId], references: [id])

  // Relations
  recruiters  RecruiterProfile[]
  jobs        Job[]
  benefits    CompanyBenefit[]
  perkRequests CompanyPerkRequest[]
  history     CompanyVerificationHistory[]
  invitations Invitation[]
}

// Superseded by CompanyPerkRequest below (Parts 6/7 of the spec) -- kept
// in place, dormant, rather than dropped, since it's a non-destructive choice
// and nothing else in this migration needs its data removed. New code should
// read/write CompanyPerkRequest exclusively.
model CompanyBenefit {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  benefitName String // Menstrual Leave Champion, Flexible Returnship, Flexible Hours etc
  verified    Boolean   @default(false)
  verifiedBy  String? // Admin username/id
  verifiedAt  DateTime?
}

// Real per-perk approval workflow (Parts 6/7/20 of the recruiter-onboarding
// spec). Deliberately its own entity, independent from Company/CompanyStatus
// -- a company's registration approval must never auto-verify or auto-reject
// its perk claims (see admin.service.ts's verifyCompany(), which no longer
// touches perks at all).
model CompanyPerkRequest {
  id        String     @id @default(uuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  perkName  String // "Menstrual Leave Champion", "Flexible Hours", "Flexible Returnship", "Work From Home", etc -- extensible, not an enum, per spec's "any future certifications"
  status    PerkStatus @default(pending)

  // Proof documents: an appended-only Json array of
  // { url, publicId, size, mimetype, category, uploadedAt, version }, same
  // shape as Company.verificationDocuments -- versioned/timestamped per
  // Part 13, never overwritten.
  documents Json?

  adminComment     String? // admin's rejection reason / info-request ask
  recruiterComment String? // recruiter's reply, set on resubmission

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
}

model CompanyVerificationHistory {
  id        String        @id @default(uuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status    CompanyStatus
  notes     String?
  adminId   String
  admin     User          @relation(fields: [adminId], references: [id])
  createdAt DateTime      @default(now())
}

model Skill {
  id         String           @id @default(uuid())
  name       String           @unique
  candidates CandidateSkill[]
  jobs       JobSkill[]
}

model CandidateSkill {
  id          String           @id @default(uuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
}

model JobSkill {
  id      String @id @default(uuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model Job {
  id                     String        @id @default(uuid())
  title                  String
  location               String
  type                   String // Full Time, Part Time
  workMode               WorkMode      @default(Remote)
  description            String
  responsibilities       String
  requirements           String
  benefits               String
  deadline               String // DD/MM/YYYY
  menstrualLeaveChampion Boolean       @default(false)
  flexibleHours          Boolean       @default(false)
  workFromHome           Boolean       @default(false)
  status                 JobStatus     @default(approved)
  reported               Boolean       @default(false)
  visibility             JobVisibility @default(visible)
  featured               Boolean       @default(false)
  postedOn               DateTime      @default(now())

  // Normalized Salary
  salaryDisplay String
  salaryMin     Int
  salaryMax     Int

  // Normalized References
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id])
  recruiterId  String
  recruiter    RecruiterProfile @relation(fields: [recruiterId], references: [id])
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id])

  // Relations
  skills       JobSkill[]
  applications Application[]
  savedJobs    SavedJob[]
  reports      JobReport[]
  history      JobStatusHistory[]

  @@index([companyId])
  @@index([recruiterId])
  @@index([status])
}

model Application {
  id              String            @id @default(uuid())
  jobId           String
  job             Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status          ApplicationStatus @default(Applied)
  appliedOn       DateTime          @default(now())
  offerDetails         String?
  offerReleasedAt      DateTime?
  // Optional attached offer letter document (PDF/DOC/DOCX), uploaded to
  // Cloudinary the same way resumes/verification documents are -- see
  // recruiter.service.ts's releaseOffer().
  offerLetterUrl       String?
  offerLetterPublicId  String?

  // Relations
  history    ApplicationStatusHistory[]
  interviews Interview[]

  @@index([candidateId])
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  changedBy     String // RecruiterName, CandidateName, System
  notes         String?
  createdAt     DateTime          @default(now())
}

model Interview {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  scheduledAt   DateTime
  durationMins  Int         @default(60)
  // Kept for backward compatibility with rows written before the
  // mode/meetingLink/venue split below -- the service still populates it
  // (meetingLink for Online, venue for Offline) so any older read path that
  // only knows about `location` keeps working unmodified.
  location      String? // Video link / office address
  status        String      @default("Scheduled") // Scheduled, Completed, Cancelled
  createdAt     DateTime    @default(now())

  // Issue 1 (Candidate Job Lifecycle spec): the recruiter scheduling modal
  // previously only captured title/date/location, one flat text field doing
  // triple duty as meeting link, office address, or nothing at all. These
  // columns give each of the spec'd fields (Timezone, Interview Mode,
  // Meeting Link, Venue, Notes) its own real, validated home.
  mode        String   @default("Online") // "Online" | "Offline"
  timezone    String? // IANA zone string, e.g. "Asia/Kolkata" -- the candidate's device renders scheduledAt in their own local time regardless, this is what the recruiter intended/confirmed on the call.
  meetingLink String? // set when mode = "Online"
  venue       String? // set when mode = "Offline"
  notes       String? // recruiter-authored notes shown to the candidate, distinct from the internal `description` field
}

model SavedJob {
  id          String           @id @default(uuid())
  jobId       String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  savedAt     DateTime         @default(now())

  @@unique([jobId, candidateId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?
  revoked   Boolean  @default(false)
  // Correlates this refresh token back to the Session row it was issued
  // alongside (see AuthService.createAuthSession). Nullable/unindexed-FK by
  // design -- rows created before this field existed have no value, and
  // Session rows are never hard-deleted (only revoked), so a plain string
  // correlation key is enough for sessionTimeout.middleware.ts to revoke a
  // session's refresh token when it force-expires it for inactivity,
  // without a real FK relation.
  sessionId String?

  @@index([sessionId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String
  userAgent    String
  deviceType   String? // Desktop, Mobile, Tablet
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  revoked      Boolean  @default(false)
}

// Singleton row (fixed id "singleton") holding platform-wide admin security
// policy. Only a Super Admin can change it (admin.routes.ts) -- distinct
// from the personal Administrator Profile Details on AdminProfile, this
// governs every Admin/Super Admin/Moderator/Support Executive session
// platform-wide, enforced by sessionTimeout.middleware.ts.
model SecurityPolicy {
  id String @id @default("singleton")

  // Minutes of inactivity after which an admin-tier session is force-expired.
  // Null/0 disables enforcement entirely (the honest default -- there was no
  // real enforcement before this field existed).
  adminSessionTimeoutMinutes Int?

  // When true, every admin-tier account (Admin/Super Admin/Moderator/
  // Support Executive) without User.twoFactorEnabled is blocked from all
  // /admins/* routes until they enroll -- see enforceTwoFactorPolicy in
  // securityPolicy.middleware.ts. They can still log in and reach the
  // enrollment endpoints (under /auth/2fa/enroll/*), so this can't lock
  // anyone out permanently.
  forceTwoFactorForAdmins Boolean @default(false)

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

// Singleton row (fixed id "singleton") holding general, non-security
// platform settings. First (and currently only) field: the "Operations
// Support Contacts" technical helpdesk email shown on the admin Help &
// Support page, which used to be hardcoded straight into HelpSupport.tsx's
// JSX with no way to change it without a code deploy. Both Admin and Super
// Admin can edit it (see admin.routes.ts) -- deliberately not restricted to
// Super Admin only like SecurityPolicy, since this isn't a security control.
model PlatformSettings {
  id String @id @default("singleton")

  // Falls back to env.SUPPORT_EMAIL / SES_FROM in the API layer when unset,
  // so the card never renders empty before an admin has ever touched this.
  supportContactEmail String?

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  operatorId    String?
  operator      User?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  operatorEmail String?
  category      String
  action        String
  entity        String? // Job, Company, User etc
  entityId      String?
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  browser       String?
  device        String?

  // Added for the Activity Logs real server-side pagination/filtering pass
  // (Final Implementation Pass, Part 2): admin.service.ts's getAuditLogs()
  // now always orders by timestamp desc and frequently filters by
  // category/entity/operatorId, so these keep those queries index-backed
  // instead of falling back to a full table scan as the table grows.
  @@index([timestamp])
  @@index([category])
  @@index([entity])
  @@index([operatorId])
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  title       String
  message     String
  category    String // Application, Moderation, System
  priority    String    @default("Medium") // High, Medium, Low
  actionUrl   String?
  metadata    Json?
  read        Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  // Optional idempotency key for event-driven notifications (job lifecycle
  // events, etc). Nullable + unique: Postgres treats every NULL as distinct
  // in a unique index, so notification types that don't set this (chat,
  // interviews, etc) are completely unaffected, while a retried/duplicated
  // domain event (e.g. an admin double-clicking "Approve") can safely
  // attempt to create the same notification twice -- the second insert hits
  // the unique constraint and is skipped instead of creating a duplicate row.
  dedupeKey   String?   @unique

  @@index([recipientId])
}

model Conversation {
  id           String                    @id @default(uuid())
  createdAt    DateTime                  @default(now())
  participants ConversationParticipant[]
  messages     Message[]

  // Final Implementation Pass, Part 10: concurrency hardening for
  // ConversationService.getOrCreateForApplication(). Previously two
  // near-simultaneous requests for the same candidate+recruiter pair could
  // both pass a racy findFirst() check before either had committed its
  // create(), silently splitting that pair's message history across two
  // Conversation rows. participantsKey is a deterministic, sorted
  // "candidateUserId:recruiterUserId" identity for the two-party
  // relationship this schema models (see ConversationService.pairKey()),
  // backed by a real Postgres UNIQUE constraint so the create half of the
  // service's upsert() can never succeed twice for the same pair. Nullable
  // because pre-existing rows are backfilled best-effort in the migration
  // for this column -- any true legacy duplicate pairs are intentionally
  // left unkeyed rather than merged (merging conversation/message history
  // is a distinct, higher-risk operation this fix does not attempt).
  // Postgres allows multiple NULLs under a UNIQUE constraint, so those rows
  // don't block anything.
  participantsKey String? @unique
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  content        String
  timestamp      DateTime     @default(now())
  // Final Implementation Pass, Part 5: persistent message read state.
  // `message:read` was previously an ephemeral Socket.IO broadcast only --
  // nothing was ever written to the database, so a page refresh (or a
  // recipient who was offline when the event fired) lost all read-state
  // information permanently. Conversations in this schema are strictly
  // two-party (see ConversationService.getOrCreateForApplication -- always
  // exactly one candidate + one recruiter), so a single `readAt` timestamp
  // per message is sufficient; a group-conversation read-receipt-per-user
  // join table would be over-engineering for a relationship this schema
  // doesn't model.
  readAt         DateTime?

  @@index([conversationId])
  @@index([conversationId, senderId, readAt])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique // chat_enabled, email_automation etc
  value       Boolean  @default(false)
  category    String // Communication, Platform, Notifications, Analytics, Experimental, Security
  description String?
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

model JobReport {
  id         String   @id @default(uuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime @default(now())
}

// "Report Platform Issue" tickets -- submittable by Candidate, Recruiter, and
// Admin-tier users alike (previously admin-only and email-only, with no DB
// record at all; see admin.service.ts's old submitSupportTicket). Every
// ticket is visible to the whole admin tier (Admin/Super Admin/Moderator
// read-only progress view; Support Executive owns the queue and can update
// status/resolve).
model SupportTicket {
  id       String       @id @default(uuid())
  subject  String
  category String
  message  String
  status   TicketStatus @default(Open)

  submittedById String
  submittedBy   User   @relation("TicketSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  // Snapshot of the submitter's primary role at submission time (Candidate /
  // Recruiter / Admin / Super Admin / Moderator / Support Executive) -- kept
  // even if the user's roles later change, so the queue can still show "who
  // filed this and as what" accurately.
  submitterRole String

  // Nullable: newly created tickets start unassigned; the notification
  // listener fans out to every active Support Executive rather than picking
  // one, so assignment happens when a Support Executive actually opens/claims
  // the ticket (see support.service.ts).
  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  resolutionNotes String?
  resolvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments SupportTicketComment[]

  @@index([status])
  @@index([submittedById])
  @@index([assignedToId])
}

// Threaded replies on a ticket -- lets the submitter and admin-tier staff
// go back and forth without abusing status transitions (previously the only
// way to add information after filing was resolutionNotes on a status
// change, which meant "I need more details" had no way to be expressed
// without prematurely resolving/reopening the ticket).
model SupportTicketComment {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User          @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  message  String

  createdAt DateTime @default(now())

  @@index([ticketId])
}

model JobStatusHistory {
  id        String    @id @default(uuid())
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    JobStatus
  changedBy String // RecruiterName, AdminName, System
  notes     String?
  createdAt DateTime  @default(now())
}
