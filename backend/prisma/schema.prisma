datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  PendingVerification
  PendingApproval
  Active
  Rejected
  Suspended
  Blocked
}

enum CompanyStatus {
  draft
  submitted
  pending
  pending_verification
  under_review
  approved
  rejected
  info_requested
}

enum JobStatus {
  draft
  pending_approval
  approved
  paused
  closed
  archived
  flagged
}

enum JobVisibility {
  visible
  hidden
}

enum WorkMode {
  Remote
  Hybrid
  On_site
}

enum ApplicationStatus {
  Applied
  Reviewed
  Shortlisted
  InterviewScheduled
  OfferReleased
  Rejected
  Hired
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String? // Nullable for OAuth-only users
  status           UserStatus @default(PendingVerification)
  twoFactorEnabled Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  preferences      Json? // Appearance, privacy, email notification settings

  // Relations
  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
  adminProfile     AdminProfile?
  roles            UserRole[]
  refreshTokens    RefreshToken[]
  sessions         Session[]
  chats            ConversationParticipant[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  verifications    CompanyVerificationHistory[]
  featureFlags     FeatureFlag[]
  oauthAccounts    OAuthAccount[]
  jobReports       JobReport[]

  // Invitations
  createdInvitations Invitation[] @relation("Inviter")
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // e.g. "google"
  providerUserId String // ID from the OAuth provider
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
}

model EmailVerification {
  id         String    @id @default(uuid())
  email      String    @unique
  token      String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
}

model PasswordReset {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Invitation {
  id          String    @id @default(uuid())
  email       String    @unique
  token       String    @unique
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id])
  invitedById String
  invitedBy   User      @relation("Inviter", fields: [invitedById], references: [id])
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // Candidate, Recruiter, Admin, Moderator, Super Admin, Support Executive
  permissions RolePermission[]
  users       UserRole[]
  invitations Invitation[]
}

model Permission {
  id    String           @id @default(uuid())
  name  String           @unique // create:job, moderate:job, verify:company, manage:users etc
  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model CandidateProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  title              String?
  bio                String?
  phone              String?
  location           String?
  totalExperience    String?
  careerBreak        Json?
  preferredLocations String[]
  availability       String?
  avatarUrl          String?
  resumeUrl          String?
  resumePublicId     String?
  resumeMetadata     Json? // File type, size details from Cloudinary
  languages          String[]
  noticePeriod       String?
  expectedSalary     String?

  experience  Json[] // Array of JobHistory DTOs
  education   Json[] // Array of AcademicDegree DTOs
  socialLinks Json[] // Array of Link DTOs

  // Relations
  skills       CandidateSkill[]
  applications Application[]
  savedJobs    SavedJob[]
}

model RecruiterProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  fullName  String
  phone     String?
  verified  Boolean @default(false)
  jobs      Job[]
}

model AdminProfile {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
}

model Industry {
  id        String    @id @default(uuid())
  name      String    @unique
  companies Company[]
}

model Department {
  id   String @id @default(uuid())
  name String @unique
  jobs Job[]
}

model Company {
  id                    String        @id @default(uuid())
  name                  String        @unique
  description           String?
  website               String
  location              String
  status                CompanyStatus @default(pending)
  feedback              String?
  logoUrl               String?
  logoPublicId          String?
  logoMetadata          Json?
  verificationDocuments Json? // Array of docs: { url, publicId, size, mimetype, category }
  industryId            String
  industry              Industry      @relation(fields: [industryId], references: [id])

  // Relations
  recruiters  RecruiterProfile[]
  jobs        Job[]
  benefits    CompanyBenefit[]
  history     CompanyVerificationHistory[]
  invitations Invitation[]
}

model CompanyBenefit {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  benefitName String // Menstrual Leave Champion, Flexible Returnship, Flexible Hours etc
  verified    Boolean   @default(false)
  verifiedBy  String? // Admin username/id
  verifiedAt  DateTime?
}

model CompanyVerificationHistory {
  id        String        @id @default(uuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status    CompanyStatus
  notes     String?
  adminId   String
  admin     User          @relation(fields: [adminId], references: [id])
  createdAt DateTime      @default(now())
}

model Skill {
  id         String           @id @default(uuid())
  name       String           @unique
  candidates CandidateSkill[]
  jobs       JobSkill[]
}

model CandidateSkill {
  id          String           @id @default(uuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
}

model JobSkill {
  id      String @id @default(uuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model Job {
  id                     String        @id @default(uuid())
  title                  String
  location               String
  type                   String // Full Time, Part Time
  workMode               WorkMode      @default(Remote)
  description            String
  responsibilities       String
  requirements           String
  benefits               String
  deadline               String // DD/MM/YYYY
  menstrualLeaveChampion Boolean       @default(false)
  flexibleHours          Boolean       @default(false)
  workFromHome           Boolean       @default(false)
  status                 JobStatus     @default(approved)
  reported               Boolean       @default(false)
  visibility             JobVisibility @default(visible)
  featured               Boolean       @default(false)
  postedOn               DateTime      @default(now())

  // Normalized Salary
  salaryDisplay String
  salaryMin     Int
  salaryMax     Int

  // Normalized References
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id])
  recruiterId  String
  recruiter    RecruiterProfile @relation(fields: [recruiterId], references: [id])
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id])

  // Relations
  skills       JobSkill[]
  applications Application[]
  savedJobs    SavedJob[]
  reports      JobReport[]
  history      JobStatusHistory[]

  @@index([companyId])
  @@index([recruiterId])
  @@index([status])
}

model Application {
  id              String            @id @default(uuid())
  jobId           String
  job             Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status          ApplicationStatus @default(Applied)
  appliedOn       DateTime          @default(now())
  offerDetails    String?
  offerReleasedAt DateTime?

  // Relations
  history    ApplicationStatusHistory[]
  interviews Interview[]

  @@index([candidateId])
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  changedBy     String // RecruiterName, CandidateName, System
  notes         String?
  createdAt     DateTime          @default(now())
}

model Interview {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  scheduledAt   DateTime
  durationMins  Int         @default(60)
  location      String? // Video link / office address
  status        String      @default("Scheduled") // Scheduled, Completed, Cancelled
  createdAt     DateTime    @default(now())
}

model SavedJob {
  id          String           @id @default(uuid())
  jobId       String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  savedAt     DateTime         @default(now())

  @@unique([jobId, candidateId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?
  revoked   Boolean  @default(false)
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String
  userAgent    String
  deviceType   String? // Desktop, Mobile, Tablet
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  revoked      Boolean  @default(false)
}

model AuditLog {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  operatorId    String?
  operator      User?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  operatorEmail String?
  category      String
  action        String
  entity        String? // Job, Company, User etc
  entityId      String?
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  browser       String?
  device        String?
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  title       String
  message     String
  category    String // Application, Moderation, System
  priority    String    @default("Medium") // High, Medium, Low
  actionUrl   String?
  metadata    Json?
  read        Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  // Optional idempotency key for event-driven notifications (job lifecycle
  // events, etc). Nullable + unique: Postgres treats every NULL as distinct
  // in a unique index, so notification types that don't set this (chat,
  // interviews, etc) are completely unaffected, while a retried/duplicated
  // domain event (e.g. an admin double-clicking "Approve") can safely
  // attempt to create the same notification twice -- the second insert hits
  // the unique constraint and is skipped instead of creating a duplicate row.
  dedupeKey   String?   @unique

  @@index([recipientId])
}

model Conversation {
  id           String                    @id @default(uuid())
  createdAt    DateTime                  @default(now())
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  content        String
  timestamp      DateTime     @default(now())

  @@index([conversationId])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique // chat_enabled, email_automation etc
  value       Boolean  @default(false)
  category    String // Communication, Platform, Notifications, Analytics, Experimental, Security
  description String?
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

model JobReport {
  id         String   @id @default(uuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime @default(now())
}

model JobStatusHistory {
  id        String    @id @default(uuid())
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    JobStatus
  changedBy String // RecruiterName, AdminName, System
  notes     String?
  createdAt DateTime  @default(now())
}
