# =============================================================================
# JobsForWomen backend -- environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
#
# Validated by Zod at boot (src/shared/config/env.ts). If a required variable
# is missing or malformed the process prints the offending fields and exits
# with code 1 -- a crash-loop on a fresh deploy is usually a missing value here.
#
# Full reference: docs/04_ENVIRONMENT_VARIABLES.md
# NEVER commit the real .env -- it is gitignored for a reason.
# =============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- Database (REQUIRED) -----------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/jobsforwomen?schema=public"

# --- Redis (REQUIRED) --------------------------------------------------------
# Local:   redis://127.0.0.1:6379
# Upstash: rediss://default:<token>@<host>.upstash.io:6379   (note: rediss, TLS)
# Without Redis, BullMQ does not run and NO EMAILS ARE SENT.
REDIS_URL="redis://127.0.0.1:6379"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- JWT (REQUIRED) ----------------------------------------------------------
# Minimum 8 characters; use 32+ random bytes in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: JWT_ACCESS_SECRET also signs private file-download URLs. Rotating it
# logs out every user AND invalidates every outstanding file link.
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Client URLs -------------------------------------------------------------
# Feed the CORS allowlist and the links embedded in outgoing emails.
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# --- File storage ------------------------------------------------------------
# DISK_MOUNT_PATH must point at PERSISTENT storage in production (Render
# Persistent Disk, AWS EFS, Docker volume). Container filesystems are wiped on
# every redeploy -- uploads stored there are destroyed on the next release.
DISK_MOUNT_PATH=./uploads
BACKEND_URL="http://localhost:5000"

# --- Email via AWS SES (REQUIRED) --------------------------------------------
# SES identities are REGIONAL -- the sending domain must be verified in
# AWS_SES_REGION specifically. Currently verified: mail.jobsforwomen.info in
# ap-south-1.
AWS_SES_REGION=ap-south-1

# Leave both blank to use the AWS default credential chain (EC2/ECS task role,
# or a local ~/.aws profile). On Render there is no instance role, so set them.
# The IAM user needs only: ses:SendEmail and ses:GetAccount.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Must be an address on the verified domain.
SES_FROM="JobsForWomen <noreply@mail.jobsforwomen.info>"

# Client-side send-rate ceiling, in emails/second, enforced by the BullMQ email
# worker. SES sandbox accounts are capped at 1/sec -- raise this to match the
# granted rate after production access is approved.
SES_MAX_SEND_RATE_PER_SEC=1

# Optional. Required only if you want bounce/complaint events delivered to the
# /api/v1/emails/sns endpoint. Create a configuration set in SES with an SNS
# event destination, then set both of these.
SES_CONFIGURATION_SET=
SNS_TOPIC_ARN=

# Inbox for admin "Contact Support" tickets. Falls back to SES_FROM.
SUPPORT_EMAIL=

# --- Google OAuth (REQUIRED) -------------------------------------------------
# GOOGLE_CALLBACK_URL has NO default and must exactly match the URI registered
# in Google Cloud Console.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# --- Platform policy ---------------------------------------------------------
PROFILE_COMPLETION_THRESHOLD=70

# LOCAL/TEST ONLY -- allows accounts to activate without email verification.
# NEVER set this in a deployed environment.
# BYPASS_EMAIL_VERIFICATION=true

# --- Rate limiting (all optional; defaults shown) -----------------------------
# Tunable per environment without a code change. See docs/04 for the full table.
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_ADMIN_MAX=200
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_RECRUITER_MAX=150
RATE_LIMIT_RECRUITER_WINDOW_MS=60000
RATE_LIMIT_CANDIDATE_MAX=150
RATE_LIMIT_CANDIDATE_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MS=600000
RATE_LIMIT_SEARCH_MAX=300
RATE_LIMIT_SEARCH_WINDOW_MS=60000
